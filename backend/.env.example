PORT=3002

# Used by the live JAGO AI chat endpoint. Keep this key on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Obtain the client credentials and approved scope from DigiLocker / API Setu after
# your organization is approved as a Requester. The backend uses the official
# production endpoints by default; override them only if DigiLocker assigns others.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://YOUR_PUBLIC_API_HOST/api/digilocker/callback
DIGILOCKER_APP_RETURN_URI=adi-setu://digilocker/callback
DIGILOCKER_SCOPE=
